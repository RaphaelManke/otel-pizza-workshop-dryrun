# Dash0 Configuration
# Get your token from: https://app.dash0.com → Settings → Auth Tokens

DASH0_AUTH_TOKEN=your_token_here

# Your Dash0 region endpoint
# Check your Dash0 URL to determine your region:
# - US West: https://ingress.us-west-2.aws.dash0.com:4317
# - EU West: https://ingress.eu-west-1.aws.dash0.com:4317
DASH0_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317

# Shows up as deployment.environment.name on every span, metric and log
DASH0_ENVIRONMENT=workshop

# Optional: the frontend runs in the browser, so its auth token is visible to
# anyone who opens the page. Create a second token limited to "Ingesting" and
# put it here. Falls back to DASH0_AUTH_TOKEN when unset.
# DASH0_WEB_AUTH_TOKEN=

# Optional: OTLP/HTTP endpoint used by the browser. Derived from DASH0_ENDPOINT
# (without the gRPC port) when unset.
# DASH0_WEB_ENDPOINT=https://ingress.us-west-2.aws.dash0.com

# Optional: your fork's URL, attached to all telemetry as vcs.repository.url.full
# so Dash0 can link telemetry back to the code that produced it.
# VCS_REPOSITORY_URL=https://github.com/YOUR-USERNAME/otel-pizza-workshop

# Optional: Enable debugging scenarios
SLOW_KITCHEN=false
NO_DRIVERS=false
ERROR_RATE=0
